# LiveKit Cloud Credentials & Agent Worker Name
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=my-agent

# AI Model & Speech Providers
GROQ_API_KEY=your_groq_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# Backend API Endpoint
BACKEND_URL=http://localhost:5000/api

# Optional: Twilio SMS notifications
# When configured, caller receives an instant confirmation SMS with booking details
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Optional: Front desk phone number for human transfer (SIP Refer)
RESTAURANT_FRONT_DESK_PHONE=+1234567890
